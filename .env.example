# Copy to .env (git-ignored) and fill in. Values are read only from the environment;
# load them for one command with:  set -a; source .env; set +a
# None of these are needed for the tests, the demos or the synthetic controls.

# SEC EDGAR (free) requires a contact User-Agent: "Your Name your@email"
# https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT=

# finnhub.io free key: company-news headlines (about one year of history)
FINNHUB_API_KEY=

# Only for --documents fmp (earnings-call transcripts need a paid FMP plan)
FMP_API_KEY=
